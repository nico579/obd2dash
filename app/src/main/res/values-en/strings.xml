    <!-- ProbeScreen -->
    <string name="probe_title">DPF scan (experimental, read-only)</string>
    <string name="probe_intro">Queries UDS identifiers (ReadDataByIdentifier, 0x22) one by one across a given range and records WHAT THIS SCAN RETURNS: no writes, no clearing, no actuator command or forced regeneration. CAN headers disabled (ATH0): without a target address below, there\'s no way to know which ECU answered if several respond to the broadcast. Stays in the default diagnostic session: some existing identifiers may still come back as an error if they require an extended session that this tool deliberately doesn\'t request. The meaning of a positive response is left to work out afterwards, nothing is decoded automatically here.</string>
    <string name="probe_not_connected">Connect to the probe from the Dashboard to start a scan.</string>
    <string name="probe_start_did_label">Start DID (hex)</string>
    <string name="probe_end_did_label">End DID (hex)</string>
    <string name="probe_target_header_label">Target address (hex, 7E0 = engine ECU)</string>
    <string name="probe_broadcast_note">Empty = broadcast: ECUs usually do not send their negative responses (NRC) there, so \"no response\" does not prove a DID is missing. A target address only makes sense on CAN.</string>
    <string name="probe_current_did">Current DID: %1$s (%2$d/%3$d)</string>
