    <!-- AutoTestScreen -->
    <string name="smoketest_title">Automatic smoke test</string>
    <string name="smoketest_intro">Runs through a series of reads and two short writes (10s of recording, a small UDS scan) against the connected probe, with no manual steps in between. Complements the in-car checklist, doesn\'t replace it: nothing here replaces actually turning off the ignition or the screen for real.</string>
