    <!-- AutoTestScreen -->
    <string name="smoketest_title">Smoke test automatique</string>
    <string name="smoketest_intro">Enchaîne des lectures et deux écritures courtes (10 s d\'enregistrement, un petit sondage UDS) contre la sonde connectée, sans manipulation entre les étapes. Complète la checklist « en voiture », ne la remplace pas : rien ici ne remplace couper le contact ou éteindre l\'écran pour de vrai.</string>
